FROM node:22-bookworm-slim
ARG TARGETARCH

# Copy npm configuration with Portico registry auth
COPY .npmrc /etc/npmrc

# Configure npm and nvm to point to Cloudsmith
ENV NPM_CONFIG_GLOBALCONFIG=/etc/npmrc
ENV NVM_NODEJS_ORG_MIRROR=https://token:Pzmbc8Up1BHnPx1y@generic.cloudsmith.io/portico/nodejs-dist-proxy/nodejs

# Install only the packaging toolchain. Application source, node_modules,
# and build artifacts are mounted at runtime by build-with-docker.sh.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    git \
    rpm \
    fakeroot \
    dpkg \
    ca-certificates \
    && build_arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && if [ "$build_arch" = "amd64" ] || [ "$build_arch" = "x86_64" ]; then \
         apt-get install -y --no-install-recommends wine wine64; \
       else \
         echo "Skipping wine install for TARGETARCH=$build_arch"; \
       fi \
    && rm -rf /var/lib/apt/lists/*

# electron-builder needs to be able to download electron binaries
ENV ELECTRON_CACHE="/root/.cache/electron"
ENV ELECTRON_BUILDER_CACHE="/root/.cache/electron-builder"

# Allow electron-builder to build for macOS from Linux
ENV ELECTRON_BUILDER_ALLOW_UNRESOLVED_DEPENDENCIES=true
ENV USE_SYSTEM_FPM=true

WORKDIR /workspace

CMD ["bash"]

# PORTICO-205: ownership labels so cleanup tooling can select PORTICO-built images.
LABEL com.portico.ai-chat.artifact="true" \
      com.portico.ai-chat.image-role="electron-builder"
