    {
      "_comment": "Round 4 / Issue 3c — scheduled-task lifecycle tools. Creating, updating, running-now, or deleting a scheduled task fires off a chain of unattended writes against whatever integrations the task references, so we surface a chip in the MAIN chat at the moment the model proposes the change. This pulls confirmation forward from sub-agent time (where it was being asked over and over per call) to task-creation / mutation time (where the user has full context).",
      "tool_name_glob": "scheduling_create_task",
      "mcp": "scheduling",
      "summary_template": "Create scheduled task: {{prompt|truncate:140}} (schedule: {{schedule.kind}})",
      "side_effect": "external-write"
    },
    {
      "tool_name_glob": "scheduling_finalize_run",
      "mcp": "scheduling",
      "summary_template": "Record internal scheduled-run completion verdict for {{task_id}}",
