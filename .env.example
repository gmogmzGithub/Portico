# Portico configuration template.
#
# Copy to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# `.env` is gitignored -- never commit real credentials, tokens, or private
# service URLs (AGENTS.md). Every value below is a placeholder.
#
# This documents the operator-facing configuration: credentials, endpoints, and
# integration toggles. It is deliberately not an exhaustive list of every
# variable the code reads -- internal debug and test-only flags are omitted.
# Variables shown with `=` already have a working default in code or in
# docker-compose.yml; set them only to override.

# -----------------------------------------------------------------------------
# Model providers
# -----------------------------------------------------------------------------

# Optional compatibility value used by MCP processes that call Anthropic
# directly. The model gateway itself uses PORTICO_LLM_API_KEY.
ANTHROPIC_API_KEY=

# Model-provider gateway the LLM bridge talks to.
# Default: https://api.openai.com/v1
LLM_PROXY_BASE_URL=

# Optional path to a local model catalog. The default is ./model_catalog.yaml.
# Keep deployment-specific endpoints in model_catalog.local.yaml, which is
# gitignored.
PORTICO_MODEL_CATALOG_PATH=

# -----------------------------------------------------------------------------
# Package registries (build time)
# -----------------------------------------------------------------------------
#
# Public dependencies default to https://registry.npmjs.org/. Configure a
# private mirror only in an explicit local or CI environment; never commit its
# credentials.

# Optional Node distribution mirror.
NVM_NODEJS_ORG_MIRROR=

# Private npm registry and its auth token.
NPM_REGISTRY_URL=
NPM_AUTH_TOKEN=

# Cloudsmith (release publishing).
CLOUDSMITH_API_KEY=
CLOUDSMITH_OWNER=
CLOUDSMITH_REPO=
# Override only for a non-default Cloudsmith deployment.
CLOUDSMITH_API_BASE=
CLOUDSMITH_API_V2_BASE=
CLOUDSMITH_DL_BASE=

# Container registry for service images.
HARBOR_REGISTRY=
HARBOR_USER=
HARBOR_TOKEN=

# -----------------------------------------------------------------------------
# GitLab marketplace OAuth
# -----------------------------------------------------------------------------

GITLAB_MARKETPLACE_BASE_URL=
GITLAB_MARKETPLACE_CLIENT_ID=
GITLAB_MARKETPLACE_CLIENT_SECRET=
# Default: openid profile email read_repository read_api
GITLAB_MARKETPLACE_SCOPES=

# -----------------------------------------------------------------------------
# Vault (LLM API key retrieval)
# -----------------------------------------------------------------------------

VAULT_ADDR=
VAULT_AUTH_ROLE=
# Path to the secret holding the LLM API key.
VAULT_SECRET_PATH=
# Bypass Vault by supplying the key to the installer process. On macOS the
# installer persists it to Keychain and scrubs plaintext runtime fallbacks.
PORTICO_LLM_API_KEY=

# -----------------------------------------------------------------------------
# Host MCP Bridge telemetry (LogRepo) -- opt-in
# -----------------------------------------------------------------------------
#
# Disabled unless BOTH the enable flag is truthy AND a URL is set. The payload
# includes user identity (ldap, machine_hash), so there is no default endpoint.

PORTICO_MCP_BRIDGE_LOGREPO_ENABLED=
PORTICO_MCP_BRIDGE_LOGREPO_URL=

# Identity and build metadata stamped onto telemetry events.
PORTICO_USER_ID=
PORTICO_APP_VERSION=
PORTICO_BUILD_CHANNEL=
PORTICO_MACHINE_HASH=

# -----------------------------------------------------------------------------
# Miscellaneous services
# -----------------------------------------------------------------------------

# Artifact upload endpoint.
PORTICO_UPLOAD_SERVICE_URL=

# Directory for cached OAuth tokens. Defaults to a path under userData.
PORTICO_OAUTH_TOKEN_CACHE_DIR=

# Standard proxy settings, honoured by the compose stack.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
