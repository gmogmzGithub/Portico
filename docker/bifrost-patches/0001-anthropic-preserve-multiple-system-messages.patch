diff --git a/core/providers/anthropic/chat_test.go b/core/providers/anthropic/chat_test.go
index 04df3bd..debe09a 100644
--- a/core/providers/anthropic/chat_test.go
+++ b/core/providers/anthropic/chat_test.go
@@ -339,0 +340,63 @@ func TestToAnthropicChatRequest_ToolInputKeyOrderPreservation(t *testing.T) {
+func TestToAnthropicChatRequest_PreservesMultipleSystemMessagesAndLegacyTopLevelCacheControl(t *testing.T) {
+	bifrostReq := &schemas.BifrostChatRequest{
+		Provider: schemas.Anthropic,
+		Model:    "atlas-sonnet-4-20250514",
+		Input: []schemas.ChatMessage{
+			{
+				Role:    schemas.ChatMessageRoleSystem,
+				Content: &schemas.ChatMessageContent{ContentStr: schemas.Ptr("<static_context>stable</static_context>")},
+			},
+			{
+				Role:    schemas.ChatMessageRoleSystem,
+				Content: &schemas.ChatMessageContent{ContentStr: schemas.Ptr("model prompt")},
+			},
+			{
+				Role:    schemas.ChatMessageRoleSystem,
+				Content: &schemas.ChatMessageContent{ContentStr: schemas.Ptr("<dynamic_context>today</dynamic_context>")},
+			},
+			{
+				Role:    schemas.ChatMessageRoleUser,
+				Content: &schemas.ChatMessageContent{ContentStr: schemas.Ptr("hello")},
+			},
+		},
+		Params: &schemas.ChatParameters{
+			ExtraParams: map[string]interface{}{
+				"cache_control": map[string]interface{}{"type": "ephemeral"},
+			},
+		},
+	}
+
+	ctx, cancel := schemas.NewBifrostContextWithCancel(nil)
+	defer cancel()
+	result, err := ToAnthropicChatRequest(ctx, bifrostReq)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if result.CacheControl == nil || result.CacheControl.Type != "ephemeral" {
+		t.Fatalf("expected top-level cache_control to be preserved, got %#v", result.CacheControl)
+	}
+	if result.ExtraParams["cache_control"] != nil {
+		t.Fatalf("expected cache_control to be removed from extra params, got %#v", result.ExtraParams["cache_control"])
+	}
+	if result.System == nil || len(result.System.ContentBlocks) != 3 {
+		t.Fatalf("expected 3 system blocks, got %#v", result.System)
+	}
+
+	got := []string{
+		*result.System.ContentBlocks[0].Text,
+		*result.System.ContentBlocks[1].Text,
+		*result.System.ContentBlocks[2].Text,
+	}
+	want := []string{
+		"<static_context>stable</static_context>",
+		"model prompt",
+		"<dynamic_context>today</dynamic_context>",
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("system block %d: expected %q, got %q", i, want[i], got[i])
+		}
+	}
+}
+
