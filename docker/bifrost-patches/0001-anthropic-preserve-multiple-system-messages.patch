+func appendAnthropicSystemBlocks(target *[]AnthropicContentBlock, content *AnthropicContent) {
+	if content == nil {
+		return
+	}
+
+	if content.ContentStr != nil && *content.ContentStr != "" {
+		*target = append(*target, AnthropicContentBlock{
+			Type: AnthropicContentBlockTypeText,
+			Text: content.ContentStr,
+		})
+		return
+	}
+
+	*target = append(*target, content.ContentBlocks...)
+}
