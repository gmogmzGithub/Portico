+func requestHeaderString(ctx *fasthttp.RequestCtx, name string) string {
+	return strings.TrimSpace(string(ctx.Request.Header.Peek(name)))
+}
+
+func requestHeaderValue(ctx *fasthttp.RequestCtx, name string) string {
+	value := requestHeaderString(ctx, name)
+	if value == "" {
+		return "-"
+	}
+	return value
+}
+
+func requestHeaderPresent(ctx *fasthttp.RequestCtx, name string) bool {
+	return requestHeaderString(ctx, name) != ""
+}
+
+func requestHeaderInt64(ctx *fasthttp.RequestCtx, name string) (int64, bool) {
+	value := requestHeaderString(ctx, name)
+	if value == "" {
+		return 0, false
+	}
+	parsed, err := strconv.ParseInt(value, 10, 64)
+	if err != nil || parsed < 0 {
+		return 0, false
+	}
+	return parsed, true
+}
