+const owuiBifrostReceivedAtKey schemas.BifrostContextKey = "openwebui-bifrost-received-at-ms"
+
+func owuiRequestHeaders(ctx *schemas.BifrostContext) map[string]string {
+	headers, _ := ctx.Value(schemas.BifrostContextKeyRequestHeaders).(map[string]string)
+	return headers
+}
+
+func owuiHeaderString(headers map[string]string, name string) string {
+	if headers == nil {
+		return "-"
+	}
+	value := strings.TrimSpace(headers[strings.ToLower(name)])
+	if value == "" {
+		return "-"
+	}
+	return value
+}
+
+func owuiHeaderInt64(headers map[string]string, name string) (int64, bool) {
+	if headers == nil {
+		return 0, false
+	}
+	rawValue := strings.TrimSpace(headers[strings.ToLower(name)])
+	if rawValue == "" {
+		return 0, false
+	}
+	value, err := strconv.ParseInt(rawValue, 10, 64)
+	if err != nil || value < 0 {
+		return 0, false
+	}
+	return value, true
+}
